# macOS
.DS_Store

# Secrets / local config
.env
*.local

# Strava API application credentials (ADR-023). The client id is public, the client secret
# is not, and this repository is. `ios/Strava.example.xcconfig` is the tracked template;
# `xcodegen generate` copies it here when this file is missing, so a fresh clone builds.
ios/Strava.xcconfig

# Python (lab/)
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Swift / Xcode (ios/)
.build/
DerivedData/
xcuserdata/
*.xcuserstate
.swiftpm/

# Connect IQ (garmin/)
garmin/bin/
garmin/field/bin/
*.prg
*.prg.debug.xml
monkey.jungle.local

# Developer key — NEVER commit
*.der
developer_key*

# Invite-beta pepper — generated from UNLOCK_SECRET in lab/.env by
# `lab/tools/make_unlock.py --emit-pepper`. Committing it would publish the only secret the
# unlock gate has (docs/decisions.md ADR-012). Both paths are ignored: gen/ is where the
# tool writes, source/gen/ would silently arm the gate in the PUBLIC build if anyone ever
# moved it there.
garmin/gen/
garmin/source/gen/

# The screenshot harness. Its own header says it: "THROWAWAY screenshot harness. Not shipped,
# not committed, not referenced by any build." It subclasses the real app to stage the store
# screenshots in the simulator and is rewritten for whatever shot is being taken, so a tracked
# copy is a diff on every screenshot run and a second WingfoilApp for a reader to trip over.
# It was tracked until 19 Sep 2026 (docs/engineering.md, "The rules reconciled"); the file
# stays on disk, git just stops carrying it.
garmin/screenshots/source/ShotsApp.mc

# Footage fixtures: gigabytes of video per afternoon. Only the README, the ground truth
# and the alignment result are tracked (fixtures/footage/README.md).
fixtures/footage/**
!fixtures/footage/README.md
!fixtures/footage/*/
!fixtures/footage/*/README.md
!fixtures/footage/*/truth.json
!fixtures/footage/*/align.json
ios/Strava.xcconfig
garmin/screenshots/tools/winfo
