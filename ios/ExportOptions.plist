<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>upload</string>
    <key>teamID</key>
    <string>685X8YLYSB</string>
    <key>signingStyle</key>
    <string>manual</string>
    <key>signingCertificate</key>
    <string>Apple Distribution</string>
    <!--
      Manual signing needs one profile per embedded bundle id. The WidgetKit extension
      (de.lahmann.wingfoil.widgets) is embedded in the app as of the widgets change, so
      exporting this archive needs a profile for it too.

      Until that profile exists in the developer portal, export with automatic signing
      (Xcode Organizer → Distribute App, or signingStyle=automatic here), which creates it.
      Once it exists, uncomment the second entry below and manual export works again:

          <key>de.lahmann.wingfoil.widgets</key>
          <string>WingFoil Widgets App Store</string>

      See docs/decisions.md, "Widgets and the app group".
    -->
    <key>provisioningProfiles</key>
    <dict>
        <key>de.lahmann.wingfoil</key>
        <string>WingFoil App Store</string>
        <key>de.lahmann.wingfoil.widgets</key>
        <string>WingFoil Widgets App Store</string>
        <key>de.lahmann.wingfoil.watchkitapp</key>
        <string>WingFoil Watch App Store</string>
    </dict>
    <key>uploadSymbols</key>
    <true/>
    <key>manageAppVersionAndBuildNumber</key>
    <true/>
</dict>
</plist>
