<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>upload</string>
    <key>teamID</key>
    <string>685X8YLYSB</string>
    <key>signingStyle</key>
    <string>manual</string>
    <key>signingCertificate</key>
    <string>Apple Distribution</string>
    <!--
      Manual signing needs one profile per embedded bundle id, and this one file serves all
      three channels (docs/channels.md) because a bundle id appears in exactly one of them:

        release  de.lahmann.wingfoil                        — no widgets, no watch app
        beta     de.lahmann.wingfoil + the three embedded ids
        dev      de.lahmann.wingfoil.dev + its own three

      An entry for a bundle id the archive does not contain is ignored, so the release
      export reads the first line and nothing else. The four "CleanJibe Dev …" profiles were
      created through the ASC API on 14 Sep 2026; see docs/decisions.md, "Widgets and the
      app group", for what the App Groups capability still needs from the portal.
    -->
    <key>provisioningProfiles</key>
    <dict>
        <key>de.lahmann.wingfoil</key>
        <string>WingFoil App Store</string>
        <key>de.lahmann.wingfoil.widgets</key>
        <string>WingFoil Widgets App Store</string>
        <key>de.lahmann.wingfoil.watchkitapp</key>
        <string>WingFoil Watch App Store</string>
        <!--
          The watch-face complication (docs/decisions.md ADR-018). It is embedded in the watch
          app, which is embedded in the phone app, so manual export needs its profile too —
          three levels down and still one line here.
        -->
        <key>de.lahmann.wingfoil.watchkitapp.widgets</key>
        <string>WingFoil Watch Widgets App Store</string>
        <!-- The dev channel: a second app, so a second set of four. -->
        <key>de.lahmann.wingfoil.dev</key>
        <string>CleanJibe Dev App Store</string>
        <key>de.lahmann.wingfoil.dev.widgets</key>
        <string>CleanJibe Dev Widgets App Store</string>
        <key>de.lahmann.wingfoil.dev.watchkitapp</key>
        <string>CleanJibe Dev Watch App Store</string>
        <key>de.lahmann.wingfoil.dev.watchkitapp.widgets</key>
        <string>CleanJibe Dev Watch Widgets App Store</string>
    </dict>
    <key>uploadSymbols</key>
    <true/>
    <key>manageAppVersionAndBuildNumber</key>
    <true/>
</dict>
</plist>
