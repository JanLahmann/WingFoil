{
  "version": 1,
  "contract": "docs/presentation.md",
  "note": "The single source for presentation VALUES. Edit this file, then run design/generate_tokens.py; ios/WingFoilKit/Sources/WingFoilKit/Presentation/DesignTokens.swift, web/css/tokens.css and web/js/tokens.js are generated from it and CI fails on drift (design/check_tokens.py --check).",
  "colorNote": "Every colour carries BOTH forms because the two platforms speak different languages: `hex` is what the web renders, `swiftUI` is the semantic system colour the iOS app asks for (which adapts to light/dark and to the accessibility settings, and is therefore NOT the same literal RGB as `hex`). Each platform consumes its native form; the pair is the token.",
  "colors": {
    "outcome": {
      "flew": {
        "hex": "#0ca30c",
        "swiftUI": "green",
        "means": "flew through — carried the maneuver on the foil"
      },
      "touchdown": {
        "hex": "#fab219",
        "swiftUI": "orange",
        "means": "touchdown — lost it briefly"
      },
      "fellIn": {
        "hex": "#d03b3b",
        "swiftUI": "red",
        "means": "fell in — swam"
      },
      "courseChange": {
        "hex": "#7a7a72",
        "swiftUI": "gray",
        "means": "bear-away / round-up — a non-verdict, deliberately outside the ladder"
      }
    },
    "effort": {
      "pumping": {
        "hex": "#8f7ce8",
        "swiftUI": "indigo",
        "means": "pump-burst spans on the track"
      },
      "takeoff": {
        "hex": "#3987e5",
        "swiftUI": "blue",
        "means": "takeoff attempts that flew"
      },
      "splash": {
        "hex": "#3fc4d8",
        "swiftUI": "cyan",
        "means": "the barometer saw the wrist go under"
      },
      "failedTakeoff": {
        "hex": "#d03b3b",
        "swiftUI": "red",
        "means": "the one effort-layer event with an outcome, so it alone borrows the ladder's red"
      }
    },
    "phase": {
      "flying": {
        "hex": "#3987e5",
        "swiftUI": "teal",
        "means": "track tinted on foil"
      },
      "offFoil": {
        "hex": "#4a4a45",
        "swiftUI": "secondary",
        "means": "track tinted off foil"
      }
    },
    "direction": {
      "ink": {
        "hex": "#c3c2b7",
        "swiftUI": "primary",
        "means": "chevron ink — subordinate to every marker, so ink plus opacity, no hue"
      }
    }
  },
  "opacity": {
    "directionWeb": 0.42,
    "directionFlying": 0.62,
    "directionOffFoil": 0.38,
    "directionNeutral": 0.22
  },
  "glyphs": {
    "takeoffPumped": {
      "sfSymbol": "arrow.up.circle.fill",
      "webShape": "arrow-up",
      "means": "filled up-arrow — this cost something"
    },
    "takeoffFree": {
      "sfSymbol": "arrow.up.circle",
      "webShape": "arrow-up-hollow",
      "means": "hollow up-arrow — the wind did it"
    },
    "takeoffFailed": {
      "sfSymbol": "arrow.uturn.down.circle",
      "webShape": "uturn",
      "means": "hollow red u-turn — went at it and came back down"
    },
    "splash": {
      "sfSymbol": "drop.fill",
      "webShape": "drop",
      "means": "drop glyph — submersion evidence"
    }
  },
  "recordWindows": {
    "default": "best2s",
    "order": [
      { "id": "best2s", "label": "2 s" },
      { "id": "best10s", "label": "10 s" },
      { "id": "best5x10s", "label": "5 × 10 s" },
      { "id": "best100m", "label": "100 m" },
      { "id": "best250m", "label": "250 m" },
      { "id": "best500m", "label": "500 m" },
      { "id": "bestNm", "label": "1 NM" },
      { "id": "alpha500", "label": "Alpha 500" }
    ]
  },
  "layers": [
    { "id": "flying", "label": "flying", "defaultVisible": true },
    { "id": "offFoil", "label": "off foil", "defaultVisible": true },
    { "id": "effort", "label": "best effort", "defaultVisible": true },
    { "id": "pumping", "label": "pumping", "defaultVisible": true },
    { "id": "flewThrough", "label": "flew through", "defaultVisible": true },
    { "id": "touchdown", "label": "touchdown", "defaultVisible": true },
    { "id": "fellIn", "label": "fell in", "defaultVisible": true },
    { "id": "courseChange", "label": "course change", "defaultVisible": true },
    { "id": "takeoff", "label": "takeoff", "defaultVisible": true },
    { "id": "splash", "label": "splash", "defaultVisible": true },
    { "id": "direction", "label": "direction", "defaultVisible": true }
  ]
}
