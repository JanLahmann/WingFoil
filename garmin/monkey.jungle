project.manifest = manifest.xml

# tests/ holds (:test)-annotated code — stripped from normal builds, compiled with --unit-test
#
# source-nopepper/ carries the all-zero invite pepper, which is what makes LockGate.enabled()
# false and the lock screen unreachable in the public app. Only monkey-invite.jungle swaps it
# for the generated gen/UnlockPepper.mc (docs/decisions.md ADR-012).
base.sourcePath = source;tests;source-nopepper

# WingFoilCore = the shared detection core (RingBuffer/SpeedRecords/FlightDetector/
# TurnDetector/Config), linked as a Monkey Barrel PROJECT dependency (not a packaged
# .barrel), so editing the core rebuilds both apps with no export step. Its tests/ come
# along, which is why --unit-test on this jungle still runs the full 16-test suite.
base.barrelPath = barrel/WingFoilCore/barrel.jungle

# Resolution-specific layout overrides land here later, e.g.:
# fenix8solar47mm.resourcePath = $(fenix8solar47mm.resourcePath);resources-mip

# Everything below maps a product to a qualifier resource directory. Those directories were
# opened for LAUNCHER ICONS at each product's native size, and since 0.9.5 they carry a second
# bitmap: the brand mark the start page and the post-save verdict page draw (source/ui/Brand.mc).
# The mark needs a different partition from the icon — one cut per DISPLAY CLASS and glass size,
# not per icon size — and it does not need a new set of directories, because the partition the
# icons already produce happens to be exactly right: resources-icon40's audience is precisely
# the thirteen 8 bpp MIP products, resources-icon60/-icon54 are the AMOLED families whose
# narrowest member is 390 px, and what is left on the base path is the six 454 px AMOLEDs.
# A product moved between these lines therefore moves its mark too, which is the intended
# behaviour and is worth knowing before adding a fourteenth MIP product to icon60.
#
# Launcher icons at each product's NATIVE size (compiler.json launcherIcon):
# fenix847mm / fenix8pro47mm want 65x65 (that is what resources/ holds), fenix843mm 60x60 and
# both Solar variants 40x40. Without these overrides monkeyc rescales the 65x65 and warns on
# every build; the qualifier directories carry nothing but the correctly sized bitmap.
fenix843mm.resourcePath = $(fenix843mm.resourcePath);resources-icon60
fenix8solar47mm.resourcePath = $(fenix8solar47mm.resourcePath);resources-icon40
fenix8solar51mm.resourcePath = $(fenix8solar51mm.resourcePath);resources-icon40

# fenix 7 family: compiler.json launcherIcon is 40x40 on all eight variants, so they reuse
# the Solar cut. Without this monkeyc rescales the 65x65 in resources/ and warns per build.
fenix7.resourcePath = $(fenix7.resourcePath);resources-icon40
fenix7s.resourcePath = $(fenix7s.resourcePath);resources-icon40
fenix7x.resourcePath = $(fenix7x.resourcePath);resources-icon40
fenix7pro.resourcePath = $(fenix7pro.resourcePath);resources-icon40
fenix7pronowifi.resourcePath = $(fenix7pronowifi.resourcePath);resources-icon40
fenix7spro.resourcePath = $(fenix7spro.resourcePath);resources-icon40
fenix7xpro.resourcePath = $(fenix7xpro.resourcePath);resources-icon40
fenix7xpronowifi.resourcePath = $(fenix7xpronowifi.resourcePath);resources-icon40

# Tier A launcher icons, again at each product's native compiler.json launcherIcon size.
# 40x40: fr955, fr255, enduro3 (the MIP tier, same cut the fenix 7s use).
# 54x54: fr57042mm alone, which is why resources-icon54 exists at all.
# 60x60: the epix 2 / epix 2 Pro family, fr265, both MARQ 2, D2 Mach 1, Descent Mk3 43mm.
# 65x65: fr965, fr970, fr57047mm, d2mach2 — that is what resources/ already holds, so they
#        take no line here.
fr955.resourcePath = $(fr955.resourcePath);resources-icon40
fr255.resourcePath = $(fr255.resourcePath);resources-icon40
enduro3.resourcePath = $(enduro3.resourcePath);resources-icon40
fr57042mm.resourcePath = $(fr57042mm.resourcePath);resources-icon54
epix2.resourcePath = $(epix2.resourcePath);resources-icon60
epix2pro42mm.resourcePath = $(epix2pro42mm.resourcePath);resources-icon60
epix2pro47mm.resourcePath = $(epix2pro47mm.resourcePath);resources-icon60
epix2pro51mm.resourcePath = $(epix2pro51mm.resourcePath);resources-icon60
fr265.resourcePath = $(fr265.resourcePath);resources-icon60
marq2.resourcePath = $(marq2.resourcePath);resources-icon60
marq2aviator.resourcePath = $(marq2aviator.resourcePath);resources-icon60
d2mach1.resourcePath = $(d2mach1.resourcePath);resources-icon60
descentmk343mm.resourcePath = $(descentmk343mm.resourcePath);resources-icon60
