<settings>
    <!-- 0.9.23, rider review W15 ("Garmin Connect shows 140 laps, half of them not flying"):
         a lap for every flight and every gap, or one lap for the session. Beta and dev only;
         the release has neither the row nor the property and keeps a lap per flight. -->
    <setting propertyKey="@Properties.lapMode" title="@Strings.SetLaps">
        <settingConfig type="list">
            <listEntry value="0">@Strings.LapsPerFlight</listEntry>
            <listEntry value="1">@Strings.LapsSession</listEntry>
        </settingConfig>
    </setting>
    <!-- 0.9.28, with the Garmin link (docs/channels.md, Watches): the summary card and the
         direct transfer that rides on it. The same row as in resources-dev/base; the
         release has neither the row nor the property, and AppSettings.readPhonePush is its
         (:nolink) false. -->
    <setting propertyKey="@Properties.phonePush" title="@Strings.SetPhonePush">
        <settingConfig type="boolean"/>
    </setting>
</settings>
