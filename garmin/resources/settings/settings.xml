<settings>
    <setting propertyKey="@Properties.foilEntryKmh" title="@Strings.SetFoilEntry">
        <settingConfig type="numeric" min="6" max="25"/>
    </setting>
    <setting propertyKey="@Properties.foilExitKmh" title="@Strings.SetFoilExit">
        <settingConfig type="numeric" min="4" max="20"/>
    </setting>
    <setting propertyKey="@Properties.entryHoldS" title="@Strings.SetEntryHold">
        <settingConfig type="numeric" min="1" max="10"/>
    </setting>
    <setting propertyKey="@Properties.exitHoldS" title="@Strings.SetExitHold">
        <settingConfig type="numeric" min="1" max="10"/>
    </setting>
    <setting propertyKey="@Properties.minFlightS" title="@Strings.SetMinFlight">
        <settingConfig type="numeric" min="2" max="30"/>
    </setting>
    <setting propertyKey="@Properties.useKnots" title="@Strings.SetUseKnots">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.showLabels" title="@Strings.SetShowLabels">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.phonePush" title="@Strings.SetPhonePush">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.sportChoice" title="@Strings.SetSport">
        <settingConfig type="list">
            <listEntry value="0">@Strings.SportWindsurf</listEntry>
            <listEntry value="1">@Strings.SportKitesurf</listEntry>
            <listEntry value="2">@Strings.SportGeneric</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.accelLogging" title="@Strings.SetAccelLogging"
             prompt="@Strings.SetAccelLoggingNote">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.pumpDetection" title="@Strings.SetPumpDetection">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.alertTakeoff" title="@Strings.SetAlertTakeoff">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.visualAlerts" title="@Strings.SetVisualAlerts"
             prompt="@Strings.SetVisualAlertsNote">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.alertPb" title="@Strings.SetAlertPb">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.alertFlight" title="@Strings.SetAlertFlight">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.alertTurn" title="@Strings.SetAlertTurn">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.alertCleanJibe" title="@Strings.SetAlertCleanJibe"
             prompt="@Strings.SetAlertCleanJibeNote">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.windDirDeg" title="@Strings.SetWindDir">
        <settingConfig type="numeric" min="-1" max="359"/>
    </setting>
    <setting propertyKey="@Properties.autoWind" title="@Strings.SetAutoWind">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.windDefaultTurnType" title="@Strings.SetTurnHabit">
        <settingConfig type="list">
            <listEntry value="0">@Strings.TurnHabitJibes</listEntry>
            <listEntry value="1">@Strings.TurnHabitTacks</listEntry>
            <listEntry value="2">@Strings.TurnHabitBalanced</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.autoPause" title="@Strings.SetAutoPause">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.autoPauseDelayS" title="@Strings.SetAutoPauseDelay">
        <settingConfig type="numeric" min="2" max="60"/>
    </setting>
    <setting propertyKey="@Properties.alertIntervalMin" title="@Strings.SetAlertIntervalMin">
        <settingConfig type="numeric" min="0" max="120"/>
    </setting>
    <setting propertyKey="@Properties.alertIntervalKm" title="@Strings.SetAlertIntervalKm">
        <settingConfig type="numeric" min="0" max="50"/>
    </setting>
    <!-- 0.9.16: the page SET. One enum, in every stream — the per-page editor below moved
         to the dev stream in the same round, so on a release or beta watch this row is the
         page control, and it is the one a rider who needs his glasses is actually looking
         for. Large = seven screens, one giant number each (PageModel.buildLarge). -->
    <setting propertyKey="@Properties.pageSet" title="@Strings.SetPageSet"
             prompt="@Strings.SetPageSetNote">
        <settingConfig type="list">
            <listEntry value="0">@Strings.PageSetStandard</listEntry>
            <listEntry value="1">@Strings.PageSetLarge</listEntry>
        </settingConfig>
    </setting>
</settings>
