<properties>
    <!-- Defaults mirror docs/algorithms.md — change both together. -->
    <property id="foilEntryKmh" type="float">12.0</property>
    <property id="foilExitKmh" type="float">8.0</property>
    <property id="entryHoldS" type="number">2</property>
    <property id="exitHoldS" type="number">3</property>
    <property id="minFlightS" type="number">5</property>
    <property id="useKnots" type="boolean">false</property>
    <property id="sportChoice" type="number">0</property>
    <property id="accelLogging" type="boolean">false</property>
    <!-- Feature 4: live pump/takeoff detection off the same accelerometer -->
    <property id="pumpDetection" type="boolean">true</property>
    <property id="alertPb" type="boolean">true</property>
    <property id="alertFlight" type="boolean">true</property>
    <property id="alertTurn" type="boolean">true</property>
    <!-- 0.9.5: a rhythm of its own for a clean jibe, REPLACING the plain fly-through tick
         (AlertManager.turnResolved). Off = the 0.9.4 turn-outcome buzz, not silence. -->
    <property id="alertCleanJibe" type="boolean">true</property>
    <property id="alertTakeoff" type="boolean">true</property>
    <!-- 0.9.11: the flash and the afterglow strip beside every buzz (EventFlash). -->
    <property id="visualAlerts" type="boolean">true</property>
    <!-- wind the turn classifier splits tacks from jibes on; -1 = unset -->
    <property id="windDirDeg" type="number">-1</property>
    <!-- 0.9.0: estimate the wind axis on the watch when the rider set none. The manual
         bearing above always wins; an estimate is shown with a leading "~". -->
    <property id="autoWind" type="boolean">true</property>
    <!-- the rider's declared turn habit, the 180-degree tiebreaker on a weak no-go cone
         (docs/algorithms.md "Default turn type"). 0 jibes · 1 tacks · 2 balanced (prior off);
         mirror of WingFoilCore.TURN_TYPE_* and of the engine's windDefaultTurnType. -->
    <property id="windDefaultTurnType" type="number">0</property>
    <!-- Feature 3: auto-pause + interval alerts -->
    <property id="autoPause" type="boolean">false</property>
    <property id="autoPauseDelayS" type="number">5</property>
    <property id="alertIntervalMin" type="number">0</property>
    <property id="alertIntervalKm" type="float">0.0</property>
    <!-- Feature 5 (UI polish): cell glyphs carry the metric family; this keeps or drops the
         word beside them. -->
    <property id="showLabels" type="boolean">true</property>
    <!-- Phase 5: BLE summary card to the paired iPhone app after a save. -->
    <property id="phonePush" type="boolean">false</property>

    <!-- 0.9.16: the page SET (AppSettings.pageSet, PageModel.PAGE_SET_*).
         0 standard — the seven screens the app has always shipped.
         1 large — five screens, one giant number and its word on each, for a rider who
         cannot read four numbers on a wet glass at 25 kn. Mirror of PageModel's constants;
         change both together. It is in EVERY stream: the per-page editor below it moved to
         resources-dev/base/settings/ in the same round. -->
    <property id="pageSet" type="number">0</property>
</properties>
