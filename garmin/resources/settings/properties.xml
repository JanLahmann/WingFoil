    <property id="pg6s5" type="number">0</property>
    <!-- Page 7, the breadcrumb MAP (layout 7). It ships ON: the page has existed since 0.7
         but was never in the default set, and a rider who has to find "Map" in a layout list
         in Garmin Connect never learns it is there. It goes last because it is the one page
         that cannot be drawn into — no PAUSED banner, no state ring — which is also why the
         pager skips it while paused. On a product without WatchUi.MapTrackView PageModel
         turns it off, so those watches keep the six screens they had. Slots unused. -->
    <property id="pg7Layout" type="number">7</property>
    <property id="pg7s1" type="number">0</property>
    <property id="pg7s2" type="number">0</property>
    <property id="pg7s3" type="number">0</property>
    <property id="pg7s4" type="number">0</property>
    <property id="pg7s5" type="number">0</property>
</properties>
