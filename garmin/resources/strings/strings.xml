<strings>
    <string id="AppName">CleanJibe</string>
    <string id="AppNameBeta">CleanJibe Beta</string>
    <string id="AppNameDev">CleanJibe Dev</string>

    <!-- settings titles -->
    <string id="SetFoilEntry">Foil entry speed (km/h)</string>
    <string id="SetFoilExit">Foil exit speed (km/h)</string>
    <string id="SetEntryHold">Entry hold (s)</string>
    <string id="SetExitHold">Exit hold (s)</string>
    <string id="SetMinFlight">Min flight duration (s)</string>
    <string id="SetUseKnots">Show speed in knots</string>
    <string id="SetShowLabels">Show cell labels. Off: glyph only</string>
    <string id="SetSport">Record as sport</string>
    <string id="SportWindsurf">Windsurf (recommended)</string>
    <string id="SportKitesurf">Kitesurf</string>
    <string id="SportGeneric">Generic</string>
    <string id="SetAccelLogging">Log accelerometer for pump analysis</string>
    <string id="SetAccelLoggingNote">Records full wrist motion for pump analysis on the phone. The activity file gets roughly 20x larger, so the transfer to Garmin Connect after saving can take several minutes. Leave off for fast transfers.</string>
    <string id="SetPumpDetection">Detect pumping + takeoffs</string>
    <string id="SetAlertTakeoff">Vibrate on pumped takeoff</string>
    <string id="SetAlertPb">Vibrate on speed PB</string>
    <string id="SetAlertFlight">Vibrate on longest flight</string>
    <string id="SetAlertTurn">Vibrate on turn outcome</string>
    <string id="SetAlertCleanJibe">Vibrate on clean jibe</string>
    <string id="SetAlertCleanJibeNote">A clean jibe gets its own rising three-tick buzz. Clean: you flew through and held your speed. Off: every turn gets the plain outcome buzz.</string>
    <string id="SetWindDir">Wind direction (deg from, -1 = unset)</string>
    <string id="SetAutoWind">Estimate wind on the watch</string>
    <string id="SetTurnHabit">I mostly do</string>
    <string id="TurnHabitJibes">Jibes</string>
    <string id="TurnHabitTacks">Tacks</string>
    <string id="TurnHabitBalanced">About the same</string>
    <string id="SetPhonePush">Send summary to phone app</string>

    <string id="SetAutoPause">Auto-pause when stopped</string>
    <string id="SetAutoPauseDelay">Auto-pause delay (s)</string>
    <string id="SetVisualAlerts">Show alerts on screen</string>
    <string id="SetVisualAlertsNote">Every buzz also paints. The glass flashes the verdict for 1.5 s. A line at the top keeps the last one for 20 s.</string>
    <string id="SetAlertIntervalMin">Interval alert (min, 0 = off)</string>
    <string id="SetAlertIntervalKm">Interval alert (km, 0 = off)</string>

    <!-- FIT developer-field labels (Garmin Connect rendering) -->
    <string id="FitFoilStateChart">Foil state</string>
    <string id="FitFoilStateLabel">Foil state</string>
    <string id="FitUnitNone"> </string>
    <string id="FitFoilTime">Foil time</string>
    <string id="FitUnitSeconds">s</string>
    <string id="FitFoilPct">Foil %</string>
    <string id="FitUnitPct">%</string>
    <string id="FitFlights">Flights</string>
    <string id="FitLongestFlight">Longest flight</string>
    <string id="FitBest2s">Best 2s speed</string>
    <string id="FitUnitCms">cm/s</string>
    <string id="FitTacks">Tacks</string>
    <string id="FitJibes">Jibes</string>
    <!-- The Garmin Connect row for session field 34. No WATCH page prints this share any
         more (0.9.19 — the pages print the phone's outcome ladder), but the field is still
         written and Connect still needs a word for it: `Speed kept` is what that number is.
         docs/fit-schema.md, the box on field 34. -->
    <string id="FitTurnSuccess">Speed kept</string>
    <string id="FitPumpCadence">Pump cadence</string>
    <string id="FitUnitSpm">spm</string>
    <!-- Fields 35 and 36 folded into the packed `takeoff_pack` (55), so their two labels —
         FitTakeoffAttempts / FitTakeoffSuccesses — had no FIT contribution left to name and
         went with them (0.9.19). A packed field carries one label, not three. -->
    <string id="FitPumpStrokes">Pump strokes</string>
    <!-- 0.9.16: the page SET. The only page control a release or beta watch has; the
         per-page editor's strings moved to resources-dev/base/strings/ with its settings. -->
    <string id="SetPageSet">Data screens</string>
    <string id="SetPageSetNote">Standard shows eight screens with several numbers each. Large text shows seven screens with one big number and its word. Pick large text if the standard screens are hard to read on the water.</string>
    <string id="PageSetStandard">Standard</string>
    <string id="PageSetLarge">Large text</string>
    <string id="SetShowFoil">Show the Foil page</string>
    <string id="SetShowRecords">Show the Records page</string>
    <string id="SetShowTurns">Show the Turns page</string>
    <string id="SetShowKinds">Show the Tacks and jibes page</string>
    <string id="SetShowClock">Show the Clock page</string>
    <string id="SetShowStory">Show the Story page</string>
    <string id="SetShowMap">Show the Map page</string>
    <string id="SetShowPagesNote">Turn off a screen you never read. The Main screen always stays. The large text screens and the pages after a save follow these switches.</string>
</strings>
