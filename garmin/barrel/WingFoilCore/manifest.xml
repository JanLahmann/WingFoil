<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!--
      WingFoilCore — the UI-independent detection core shared by the WingFoil device app
      (garmin/) and the WingFoil Field data field (garmin/field/). Contains RingBuffer,
      SpeedRecords, FlightDetector, TurnDetector and the Config object the detectors read
      their thresholds from. No Toybox.Application / WatchUi / ActivityRecording dependency,
      so the same code links into a 768 KB device app and a 128 KB data field.

      Semantics are the docs/algorithms.md contract; every change here must keep
      lab/src/wingfoil_lab/{flight,turns}.py and the barrel unit tests in step.
    -->
    <iq:barrel id="1c534d23-0c02-4aa0-a7fb-7f852e647461" module="WingFoilCore"
        version="1.0.0" minApiLevel="5.0.0">
        <iq:products>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="fenix8pro47mm"/>
            <!-- fenix 7 family: the barrel product list has to be a SUPERSET of every
                 consumer's, or monkeyc refuses the link ("barrel does not support device").
                 Pure computation, so nothing here is device-specific. -->
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7pronowifi"/>
            <iq:product id="fenix7spro"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix7xpronowifi"/>
            <!-- Tier A: the barrel product list has to be a SUPERSET of every consumer's,
                 so it carries the device app's and the field's whole list. Pure computation,
                 nothing device-specific. -->
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="fr970"/>
            <iq:product id="fr255"/>
            <iq:product id="fr265"/>
            <iq:product id="fr57042mm"/>
            <iq:product id="fr57047mm"/>
            <iq:product id="marq2"/>
            <iq:product id="marq2aviator"/>
            <iq:product id="enduro3"/>
            <iq:product id="d2mach1"/>
            <iq:product id="d2mach2"/>
            <iq:product id="descentmk343mm"/>
        </iq:products>
        <!-- pure computation: the barrel itself needs no permissions -->
        <iq:permissions/>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>deu</iq:language>
        </iq:languages>
        <iq:barrels/>
        <iq:annotations/>
    </iq:barrel>
</iq:manifest>
