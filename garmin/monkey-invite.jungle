project.manifest = manifest-invite.xml

# Same sources as the public app, plus two invite-only pieces:
#   gen/             the pepper emitted by `lab/tools/make_unlock.py --emit-pepper`
#                    (gitignored — build this jungle without it and monkeyc fails on the
#                    missing UnlockPepper module, which is the intended loud failure)
#   resources-invite the `unlockKey` GCM setting the tester types the key into
# and NOT source-nopepper/, whose all-zero pepper disables the gate in every other build.
# Exactly one of the two supplies module UnlockPepper, so there is never a duplicate symbol.
base.sourcePath = source;tests;gen
base.barrelPath = barrel/WingFoilCore/barrel.jungle
base.resourcePath = $(base.resourcePath);resources-invite

# see monkey.jungle: per-product launcher icons at their native compiler.json sizes
fenix843mm.resourcePath = $(fenix843mm.resourcePath);resources-icon60
fenix8solar47mm.resourcePath = $(fenix8solar47mm.resourcePath);resources-icon40
fenix8solar51mm.resourcePath = $(fenix8solar51mm.resourcePath);resources-icon40
