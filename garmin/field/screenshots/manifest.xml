<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!-- Screenshot harness for the DATA FIELD. Same field, different entry point, a seeded
         engine and an inert compute(). Never uploaded anywhere; the store UUID stays in
         ../manifest.xml. Sibling of garmin/screenshots/, which does the same for the app. -->
    <iq:application id="185c4ffd-aee5-482c-9a33-58de8caa4718" type="datafield"
        name="@Strings.AppName" entry="ShotsFieldApp"
        launcherIcon="@Drawables.LauncherIcon" minApiLevel="5.0.0">
        <iq:products>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <!-- fr255 is the smallest round glass in the product list (260 px MIP). It takes
                 no store shot, but the layout survey is walked on it too: a 2x2 cell there is
                 130 px wide, which is where a wide row stops being a wide row. -->
            <iq:product id="fr255"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="FitContributor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>deu</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="WingFoilCore" version="1.0.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
