<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!--
      Beta-channel twin of manifest.xml (separate UUID = separate store listing = the only
      way to test the GCM settings UI and Garmin Connect dev-field rendering before release,
      same pattern as the device app's manifest-beta.xml).
    -->
    <!--
      Release version. It is an ATTRIBUTE the SDK validates (an unknown one fails the build),
      and 0.9.5 is the first field build to carry one at all — the field's version used to live
      only in the store's upload form, which is why garmin/store/listing.md had to be the
      record of what shipped. It moves together with FieldFit.APP_MINOR, the high byte of the
      FIT session's `app_version`, for the reason the device app's manifest states: a watch
      that says 0.9.5 here and writes a 1 there is a watch nobody can identify from its own
      files.
    -->
    <iq:application id="7e614501-d311-49c6-a68b-992b946e3d21" type="datafield"
        name="@Strings.AppNameBeta" entry="WingFoilFieldApp" version="0.9.5"
        launcherIcon="@Drawables.LauncherIcon" minApiLevel="5.0.0">
        <iq:products>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="fenix8pro47mm"/>
            <!-- fenix 7 family (CIQ 5.2.0, MIP 240/260/280 px). A data field reads only
                 Activity.Info, so the fenix 7's missing multiband GNSS costs nothing here;
                 the 128 KB data-field budget is the same. fenix7x is also Enduro 2, tactix 7
                 and quatix 7X Solar. -->
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7pronowifi"/>
            <iq:product id="fenix7spro"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix7xpronowifi"/>
            <!-- Tier A (docs/decisions.md ADR-014): the same CIQ >= 5.x sports watches the
                 device app gained. A data field reads only Activity.Info, so nothing here is
                 device-specific; every one of them carries at least the 128 KB data-field
                 budget the fenix 8 has (most carry 256 KB). -->
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="fr970"/>
            <iq:product id="fr255"/>
            <iq:product id="fr265"/>
            <iq:product id="fr57042mm"/>
            <iq:product id="fr57047mm"/>
            <iq:product id="marq2"/>
            <iq:product id="marq2aviator"/>
            <iq:product id="enduro3"/>
            <iq:product id="d2mach1"/>
            <iq:product id="d2mach2"/>
            <iq:product id="descentmk343mm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="FitContributor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>deu</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="WingFoilCore" version="1.0.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
