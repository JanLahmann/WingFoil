<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!--
      WingFoil Field — INVITE BETA channel (docs/decisions.md ADR-012). Identical code to
      manifest.xml; separate UUID so it is its own store listing. This one is meant to be
      PUBLIC because CIQ beta listings are developer-only, and it stays locked — computing
      nothing and contributing nothing to the FIT — until the tester enters the unlock key
      minted by lab/tools/make_unlock.py. Build it only through monkey-invite.jungle, which
      supplies the pepper that arms the lock.
    -->
    <iq:application id="f562bd43-9974-4625-af99-218df0d306d5" type="datafield"
        name="@Strings.AppNameInvite" entry="WingFoilFieldApp"
        launcherIcon="@Drawables.LauncherIcon" minApiLevel="5.0.0">
        <iq:products>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="fenix8pro47mm"/>
            <!-- fenix 7 family (CIQ 5.2.0, MIP 240/260/280 px) — added for the invite beta
                 so fenix 7 testers can join, exactly as garmin/manifest-invite.xml does.
                 A data field reads only Activity.Info, so the fenix 7's missing multiband
                 GNSS costs nothing here; the 128 KB data-field budget is the same. -->
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7pronowifi"/>
            <iq:product id="fenix7spro"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix7xpronowifi"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="FitContributor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>deu</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="WingFoilCore" version="1.0.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
