<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!--
      WingFoil Field — CIQ DATA FIELD companion to the WingFoil device app.
      It runs inside a NATIVE activity (the fenix 8 Windsurf profile, which is what Jan
      already records with), so Garmin owns the recording, the sport code, the laps and the
      GPS; this app only computes the wingfoil metrics and contributes developer fields.

      Platform budget differences vs the device app (docs/plan.md §2 CIQ platform):
        memory 128 KB (not 768) · 32 B of developer data per message (not 256) ·
        no ActivityRecording control, no addLap · Sensor.* (incl. registerSensorDataListener)
        crashes a data field, so no accelerometer and no pump metrics — see docs/fit-schema.md
        "Field-variant FIT (class d)".
      minApiLevel 5.0.0 and the product list match the device app.
    -->
    <iq:application id="22002da3-f7ef-40fc-acfb-72668ee8173d" type="datafield"
        name="@Strings.AppName" entry="WingFoilFieldApp"
        launcherIcon="@Drawables.LauncherIcon" minApiLevel="5.0.0">
        <iq:products>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="fenix8pro47mm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="FitContributor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>deu</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="WingFoilCore" version="1.0.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
