<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!--
      WingFoil — CIQ device app (watch-app). Records wingfoil sessions as FIT sport 43
      (windsurfing) with developer fields per docs/fit-schema.md.
      minApiLevel 5.0.0 covers all shipped Fenix 8 firmware (see docs/plan.md §2 CIQ facts).
    -->
    <!--
      Release version. It is an ATTRIBUTE the SDK validates (an unknown one fails the build),
      and it must move together with FitSchema.APP_MINOR — the FIT session's `app_version`
      field carries that minor number in its high byte, so a watch that says 0.8.0 here and
      writes a 1 there is a watch nobody can identify from its own files. The unit test
      `appVersionAgreesWithTheFitByte` holds the two together.
    -->
    <iq:application id="953f7547-c152-42c2-8d33-69fb59ad0bf6" type="watch-app"
        name="@Strings.AppNameBeta" entry="WingfoilApp" version="0.9.4" launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="5.0.0">
        <iq:products>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="fenix8pro47mm"/>
            <!-- fenix 7 family (CIQ 5.2.0, MIP 240/260/280 px) — added for the invite beta
                 so fenix 7 testers can join; same 786 KB app memory and 100 Hz accel as
                 fenix 8. Base fenix7/7s/7x have no multiband GNSS, which SessionController's
                 `has`-guarded GPS fallback already handles. -->
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7pronowifi"/>
            <iq:product id="fenix7spro"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix7xpronowifi"/>
            <!-- Tier A (docs/decisions.md ADR-014): every other CIQ >= 5.x sports watch
                 the current code runs on UNCHANGED. 786 KB of app memory each (fr255 is the
                 floor at 524 KB and still only 15% used), 100 Hz accelerometer, and one of
                 the screen sizes the round-display layout suite measures. epix2pro51mm also
                 covers tactix 7 - AMOLED Edition and D2 Mach 1 Pro, epix2 covers quatix 7
                 Sapphire, and fenix7x has always covered Enduro 2, tactix 7 and quatix 7X
                 Solar. Deliberately NOT here: the 128 KB fenix 5/6 bases, the 1 bpp
                 semi-octagon Instinct family, and the rectangles. -->
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="fr970"/>
            <iq:product id="fr255"/>
            <iq:product id="fr265"/>
            <iq:product id="fr57042mm"/>
            <iq:product id="fr57047mm"/>
            <iq:product id="marq2"/>
            <iq:product id="marq2aviator"/>
            <iq:product id="enduro3"/>
            <iq:product id="d2mach1"/>
            <iq:product id="d2mach2"/>
            <iq:product id="descentmk343mm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Fit"/>
            <iq:uses-permission id="FitContributor"/>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Sensor"/>
            <iq:uses-permission id="SensorLogging"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="WingFoilCore" version="1.0.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
